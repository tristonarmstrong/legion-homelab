#!/bin/bash
# Make sure Luna's own window fills the Legion's screen.
source "$(dirname "$0")/screen-env"
addr=$(hyprctl clients -j 2>/dev/null | python3 -c '
import json,sys
try:
    cs = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for c in cs:
    if c.get("class") == "luna" and c.get("mapped") and c.get("fullscreen") == 0:
        print(c["address"]); break
' 2>/dev/null)
[[ -z $addr ]] && exit 0
hyprctl dispatch "hl.dsp.focus({ window = 'address:$addr' })" >/dev/null 2>&1 ||
  hyprctl dispatch focuswindow "address:$addr" >/dev/null 2>&1
hyprctl dispatch "hl.dsp.window.fullscreen({ mode = 'fullscreen' })" >/dev/null 2>&1
exit 0
