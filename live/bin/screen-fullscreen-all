#!/bin/bash
# Force Luna's own browser window full screen. Only windows belonging to Luna's
# browser profile are touched, so the family's own browser windows are left alone.
source "$(dirname "$0")/screen-env"

for _ in $(seq 20); do
  mapfile -t addrs < <(hyprctl clients -j 2>/dev/null | JARVIS_PROFILE="$JARVIS_PROFILE" python3 -c '
import json,os,sys
profile=os.environ["JARVIS_PROFILE"].encode()
def is_jarvis(pid):
    try: return profile in open(f"/proc/{pid}/cmdline","rb").read()
    except Exception: return False
try: cs=json.load(sys.stdin)
except Exception: sys.exit(0)
for c in cs:
    cls=(c.get("class") or "")
    if c.get("mapped") and c.get("fullscreen")==0 and cls.startswith("chrome-") and is_jarvis(c["pid"]):
        print(c["address"])
' 2>/dev/null)
  [[ ${#addrs[@]} -eq 0 ]] && exit 0
  for a in "${addrs[@]}"; do
    hyprctl dispatch "hl.dsp.focus({ window = 'address:$a' })" >/dev/null 2>&1
    hyprctl dispatch "hl.dsp.window.fullscreen({ mode = 'fullscreen' })" >/dev/null 2>&1
  done
  sleep 0.25
done
exit 0
