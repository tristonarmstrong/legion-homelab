#!/bin/bash
# Force every Jarvis browser window full screen (Chromium's --start-fullscreen
# is unreliable when other windows are already tiled on the workspace).
source "$(dirname "$0")/screen-env"
for _ in $(seq 20); do
  mapfile -t addrs < <(hyprctl clients -j 2>/dev/null | python3 -c '
import json,sys
try: cs=json.load(sys.stdin)
except Exception: sys.exit(0)
for c in cs:
    cls=(c.get("class") or "")
    if c.get("mapped") and c.get("fullscreen")==0 and (cls.startswith("chrome-") or cls.startswith("chromium") or cls=="luna"):
        print(c["address"])
' 2>/dev/null)
  [[ ${#addrs[@]} -eq 0 ]] && exit 0
  for a in "${addrs[@]}"; do
    hyprctl dispatch "hl.dsp.focus({ window = 'address:$a' })" >/dev/null 2>&1
    hyprctl dispatch "hl.dsp.window.fullscreen({ mode = 'fullscreen' })" >/dev/null 2>&1
  done
  sleep 0.25
done
exit 0
